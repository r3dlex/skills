{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-catapult:readiness-contract:1",
  "title": "Readiness contract v1 public vocabulary",
  "description": "Structural vocabulary. The pinned shared Python validator owns path, digest, identity, scope, dependency and policy semantics. No schema field authenticates live operation authority.",
  "oneOf": [
    {"$ref": "#/$defs/bundle"},
    {"type": "object", "required": ["schema", "bundle"], "properties": {"schema": {"const": "direct-goal/1"}, "bundle": {"$ref": "#/$defs/bundle"}}},
    {"type": "object", "required": ["schema", "repository", "sources", "gates", "not_applicable"], "properties": {"schema": {"const": "readiness-policy/1"}, "repository": {"$ref": "#/$defs/repository"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}, "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}, "not_applicable": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}}},
    {"type": "object", "required": ["schema", "repository", "policy", "sources", "authority", "results", "completed_goals"], "properties": {"schema": {"const": "readiness-context/1"}, "repository": {"$ref": "#/$defs/repository"}, "policy": {"type": "object", "required": ["sha256", "revision", "issuer"]}, "authority": {"type": "object", "required": ["status", "stage", "goals", "issuer", "subject_sha256"]}, "sources": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "results": {"type": "array"}, "completed_goals": {"type": "array", "items": {"type": "object", "required": ["goal", "goal_sha256", "status", "issuer", "evidence", "observed_at", "expires_at"]}}}}
  ],
  "$defs": {
    "repository": {"type": "object", "required": ["id", "root"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "root": {"type": "string", "minLength": 1}}},
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "stage": {"enum": ["preparation", "implementation", "merge"]},
    "readiness": {"type": "object", "required": ["preparation", "implementation", "merge"], "additionalProperties": false, "properties": {"preparation": {"enum": ["ready", "blocked", "unknown"]}, "implementation": {"enum": ["ready", "blocked", "unknown"]}, "merge": {"enum": ["ready", "blocked", "unknown"]}}},
    "goal": {"type": "object", "required": ["id", "repository", "issue_ref", "scope", "acceptance_criteria", "dependencies", "verification", "readiness"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "repository": {"$ref": "#/$defs/repository"}, "issue_ref": {"type": "string", "minLength": 1}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "verification": {"type": "array", "minItems": 1}, "readiness": {"$ref": "#/$defs/readiness"}}},
    "bundle": {"type": "object", "required": ["schema", "id", "repository", "spec", "issue_ref", "planning_complete", "status", "goals"], "properties": {"schema": {"const": "handoff-goals/1"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "repository": {"$ref": "#/$defs/repository"}, "spec": {"$ref": "#/$defs/file"}, "issue_ref": {"type": "string", "minLength": 1}, "planning_complete": {"type": "boolean"}, "status": {"enum": ["active", "blocked", "superseded"]}, "goals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/goal"}}}},
    "gate": {"type": "object", "required": ["id", "stage", "scope", "kind"], "properties": {"id": {"type": "string"}, "stage": {"$ref": "#/$defs/stage"}, "binding": {"type": "object", "description": "Exact kind-specific fields documented in modules/readiness.md"}, "responsible": {"type": "string"}, "kind": {"type": "string", "description": "Supported: file_digest, executable_presence, measured_coverage, independent_result, ownership, branch_target, fixture, tooling, protected_approval, harness_trust. Unknown kinds remain unknown/blocked."}, "scope": {"oneOf": [{"const": {"repository": true}}, {"type": "object", "required": ["goals"], "additionalProperties": false, "properties": {"goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}]}}}
  }
}
