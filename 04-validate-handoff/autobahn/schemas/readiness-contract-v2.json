{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-catapult:readiness-contract:2",
  "title": "Readiness contract v2 public vocabulary",
  "description": "Structural vocabulary only. The pinned pure validator (lib/readiness_contract_v2.py) owns every semantic rule and the pinned observer (lib/observer.py) owns every observed fact. No field here, and no supplied artifact, carries authority by itself: authority is one verified plan-approval/1 for the exact generation, and merges additionally need a re-observed merge-certificate/1.",
  "oneOf": [
    {"$ref": "#/$defs/policy"},
    {"$ref": "#/$defs/bundle"},
    {"$ref": "#/$defs/sidecar"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/certificate"},
    {"$ref": "#/$defs/review"},
    {"$ref": "#/$defs/marker_record"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|[*?\\[\\]])"}},
    "assurance": {"enum": ["user-presence", "key-held", "in-session", "agent-self"]},
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repository", "identity_model", "sources", "required_checks", "skippable_checks", "branch_pattern", "target", "tools", "reviewer_requirements", "approval", "gates"],
      "properties": {
        "schema": {"const": "readiness-policy/2"},
        "repository": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}},
        "identity_model": {"enum": ["multi", "single"]},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "required_checks": {"$ref": "#/$defs/names"},
        "skippable_checks": {"$ref": "#/$defs/names"},
        "branch_pattern": {"type": "string", "allOf": [{"pattern": "^\\^"}, {"pattern": "\\$$"}, {"pattern": "<plan_id>"}, {"pattern": "<goal_id>"}]},
        "target": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "tools": {"$ref": "#/$defs/names"},
        "reviewer_requirements": {"const": {"independent_lane": true}},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor_sha256", "max_age_days", "accept"],
          "properties": {
            "anchor_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "max_age_days": {"const": 14},
            "accept": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ssh-tag", "in-session", "agent-self"]}},
            "default_mode": {"enum": ["agent", "prompt", "ssh-tag"]}
          }
        },
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "stage", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["ownership", "review", "branch_target", "tooling", "file_digest", "git_ancestor", "hosted_checks", "plan_approval", "fixture", "harness_trust"]},
        "stage": {"enum": ["preparation", "implementation", "merge"]},
        "scope": {"const": {"repository": true}},
        "binding": {"type": "object"},
        "not_applicable": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"enum": ["no-fixture-dependency", "no-pinned-harness"]}}},
        "responsible": {"type": "string", "minLength": 1}
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "repository", "spec", "goals"],
      "properties": {
        "schema": {"const": "handoff-goals/2"},
        "id": {"$ref": "#/$defs/id"},
        "repository": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}},
        "spec": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"$ref": "#/$defs/path"}}},
        "issue_ref": {"type": "string"},
        "attachments": {"type": "object", "properties": {"migrated_own_script_verification": {"$ref": "#/$defs/marker"}}},
        "goals": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "scope", "acceptance_criteria", "dependencies", "verification"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "issue_ref": {"type": "string"},
            "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
            "acceptance_criteria": {"$ref": "#/$defs/names", "minItems": 1},
            "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "verification": {"type": "array", "minItems": 1}
          }
        }}
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan_id", "goals"],
      "properties": {
        "schema": {"const": "readiness-sidecar/1"},
        "plan_id": {"$ref": "#/$defs/id"},
        "goals": {"type": "object", "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readiness", "coverage_status", "legacy_safe_tdd", "legacy_risk_reason"],
          "properties": {
            "readiness": {"type": "object", "additionalProperties": false, "required": ["preparation", "implementation", "merge"],
                          "properties": {"preparation": {"enum": ["unknown", "blocked"]}, "implementation": {"enum": ["unknown", "blocked"]}, "merge": {"enum": ["unknown", "blocked"]}}},
            "coverage_status": {"enum": ["unknown", "measured"]},
            "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "legacy_safe_tdd": {"type": "boolean"},
            "legacy_risk_reason": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan_id", "generation", "bundle_sha256", "spec_sha256", "policy_sha256", "sidecar_sha256", "goals", "stages", "owner", "reviewer_lane", "issued_at", "expires_at", "anchor_sha256", "assurance"],
      "properties": {
        "schema": {"const": "plan-approval/1"},
        "plan_id": {"$ref": "#/$defs/id"},
        "generation": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "goals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "stages": {"const": ["implementation", "merge"]},
        "owner": {"type": "string", "minLength": 1},
        "reviewer_lane": {"type": "string", "minLength": 1},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "anchor_sha256": {"$ref": "#/$defs/sha256"},
        "assurance": {"$ref": "#/$defs/assurance"}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repository", "plan_id", "generation", "goal_id", "approval_digest", "assurance", "pr", "head", "base", "base_ref", "merge_admission_digest", "local_gates", "required_checks", "unresolved_threads", "review_lane", "lane_independence", "admin", "adapter", "certifier", "issued_at"],
      "properties": {
        "schema": {"const": "merge-certificate/1"},
        "approval_digest": {"$ref": "#/$defs/sha256"},
        "assurance": {"$ref": "#/$defs/assurance"},
        "pr": {"type": "integer", "minimum": 1},
        "head": {"$ref": "#/$defs/commit"},
        "base": {"$ref": "#/$defs/commit"},
        "merge_admission_digest": {"$ref": "#/$defs/sha256"},
        "unresolved_threads": {"const": 0},
        "lane_independence": {"const": "declared"},
        "admin": {"type": "boolean"},
        "adapter": {"type": "string"},
        "certifier": {"type": "string", "minLength": 1},
        "gate_workspace": {
          "description": "The isolated-copy provenance the certificate binds (W9): the gate workspace's physical path and the gate-workspace/1 record's path and sha256. Pre-plan certificates carry no such field and keep validating.",
          "type": "object",
          "required": ["workspace", "record"],
          "properties": {
            "workspace": {"type": "string", "minLength": 1},
            "record": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        },
        "issued_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "review": {
      "type": "object",
      "required": ["schema", "plan_id", "goal_id", "pr", "head", "verdict", "issued_at"],
      "properties": {
        "schema": {"const": "review-lane/1"},
        "pr": {"type": "integer", "minimum": 1},
        "head": {"$ref": "#/$defs/commit"},
        "verdict": {"const": "approve"},
        "issued_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "gap": {
      "description": "One missing input of a consolidated report: what is missing (code, detail), where (gate, goal), which observed fact names it, its source, and the recovery. Ordered by code, goal, gate, fact, detail and source, without duplicates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "goal", "gate", "fact", "source", "recovery"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "goal": {"type": ["string", "null"]},
        "gate": {"type": ["string", "null"]},
        "fact": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1}
      }
    },
    "planning": {
      "description": "Planning-stage gaps by kind: the approval gap, deferred gaps (never counted as passed) and blocking gaps (unknown codes included).",
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_complete", "approval", "deferred", "blocking"],
      "properties": {
        "planning_complete": {"type": "boolean"},
        "approval": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "deferred": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "blocking": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
      }
    },
    "context": {
      "description": "readiness-context/2, rebuilt by admit-v2 and context-build alike. Only authority states authority: plan-approval/1 when admitted, otherwise a none: statement, even when the approval verified.",
      "type": "object",
      "required": ["schema", "stage", "goals", "plan_id", "generation", "approval", "assurance", "authority", "observation", "gates", "gaps", "admitted"],
      "properties": {
        "schema": {"const": "readiness-context/2"},
        "stage": {"enum": ["planning", "preparation", "implementation", "merge"]},
        "authority": {"type": "string", "pattern": "^(plan-approval/1|none: .+)$"},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "planning": {"$ref": "#/$defs/planning"},
        "admitted": {"type": "boolean"}
      }
    },
    "publication": {
      "description": "northstar-publication/2, printed by handoff-write.sh for a handoff-goals/2 bundle. It never carries authority. A marked publication adds its migrated-own-script-verification record.",
      "type": "object",
      "required": ["schema", "planning_complete", "published", "generation", "planning", "authority"],
      "properties": {
        "schema": {"const": "northstar-publication/2"},
        "planning_complete": {"type": "boolean"},
        "published": {"type": ["object", "null"]},
        "generation": {"$ref": "#/$defs/sha256"},
        "planning": {"$ref": "#/$defs/planning"},
        "authority": {"type": "string", "pattern": "^none: "},
        "migrated_own_script_verification": {"$ref": "#/$defs/marker_record"}
      }
    },
    "marker": {
      "description": "The optional publication-time marker at attachments.migrated_own_script_verification of a handoff-goals/2 bundle migrated from a registered v1 generation: an untrusted request to defer the planning-time existence check of exactly the selected own scripts, never proof or permission. The pinned validator proves its shape and goal linkage at every bundle ingress; the pinned observer proves the registration, payload, projection and fresh eligibility it names against the resolved origin/<target> base. The reserved name anywhere else, in any value type, refuses.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "registration", "generation", "legacy_bundle", "scripts"],
      "properties": {
        "schema": {"const": "migrated-own-script-verification/1"},
        "registration": {"$ref": "#/$defs/id"},
        "generation": {"$ref": "#/$defs/sha256"},
        "legacy_bundle": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                          "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "scripts": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal_id", "verification_index", "path"],
          "properties": {
            "goal_id": {"$ref": "#/$defs/id"},
            "verification_index": {"type": "integer", "minimum": 0},
            "path": {"$ref": "#/$defs/path"}
          }
        }}
      }
    },
    "marker_record": {
      "description": "migrated-own-script-verification-record/1: the canonical, byte-reproducible decision record of a marked publication (written into its generation as migrated-own-script-verification.json and registered as an artifact), or the refusal record of a marked route. The decision record carries the three sealed capture records of the publication (fresh eligibility, real-root safety, spec/policy bytes) and the deferral report; both carry the resolved base, the context clock (the base commit's committer time), no authority and readiness unknown. A refusal carries one canonical code and nothing else.",
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["schema", "base", "clock", "registration", "generation", "legacy_bundle", "fresh_eligibility", "real_root_safety", "spec_policy_bytes", "deferred", "authority", "readiness"],
          "properties": {
            "schema": {"const": "migrated-own-script-verification-record/1"},
            "base": {"$ref": "#/$defs/commit"},
            "clock": {"$ref": "#/$defs/timestamp"},
            "registration": {"$ref": "#/$defs/id"},
            "generation": {"$ref": "#/$defs/sha256"},
            "legacy_bundle": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                              "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
            "fresh_eligibility": {
              "type": "object", "additionalProperties": false,
              "required": ["merged", "open_prs", "branches", "unobservable", "fate"],
              "properties": {
                "merged": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["number", "head_ref", "merge_commit", "reached"],
                                                      "properties": {"number": {"type": ["integer", "null"]}, "head_ref": {"type": ["string", "null"]}, "merge_commit": {"type": ["string", "null"]}, "reached": {"type": ["boolean", "null"]}}}},
                "open_prs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["number", "head_ref"],
                                                        "properties": {"number": {"type": ["integer", "null"]}, "head_ref": {"type": ["string", "null"]}}}},
                "branches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "merged"],
                                                        "properties": {"ref": {"type": ["string", "null"]}, "merged": {"type": "boolean"}}}},
                "unobservable": {"type": ["string", "null"]},
                "fate": {"type": "object", "additionalProperties": false, "required": ["fate", "action", "merged", "unmerged", "in_flight", "ambiguous", "refused"],
                         "properties": {"fate": {"enum": ["completed", "unstarted", "partly-merged", "in-flight"]}, "action": {"enum": ["retire", "migrate", "migrate-unmerged", "wait"]},
                                        "merged": {"type": "array"}, "unmerged": {"type": "array"}, "in_flight": {"type": "array"}, "ambiguous": {"type": "array"}, "refused": {"type": "array"}}}
              }
            },
            "real_root_safety": {"type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["goal_id", "verification_index", "executable_available", "cwd_readable", "script_readable", "refusal_code"],
              "properties": {
                "goal_id": {"$ref": "#/$defs/id"},
                "verification_index": {"type": "integer", "minimum": 0},
                "executable_available": {"type": "boolean"},
                "cwd_readable": {"type": "boolean"},
                "script_readable": {"type": ["boolean", "null"]},
                "refusal_code": {"enum": ["verification_invalid", null]}
              }
            }},
            "spec_policy_bytes": {
              "type": "object", "additionalProperties": false,
              "required": ["policy_source", "policy_bytes", "live_bytes", "live_policy2", "mode", "amends", "spec_bytes", "spec_missing", "policy_sha256", "spec_sha256"],
              "properties": {
                "policy_source": {"enum": ["candidate", "live"]},
                "policy_bytes": {"type": ["string", "null"]},
                "live_bytes": {"type": ["string", "null"]},
                "live_policy2": {"type": "boolean"},
                "mode": {"enum": ["live", "bootstrap", "policy-amendment"]},
                "amends": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "spec_bytes": {"type": ["string", "null"]},
                "spec_missing": {"type": "boolean"},
                "policy_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "spec_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
              }
            },
            "deferred": {"type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["goal", "verification_index", "path", "status", "source", "recovery"],
              "properties": {
                "goal": {"$ref": "#/$defs/id"},
                "verification_index": {"type": "integer", "minimum": 0},
                "path": {"$ref": "#/$defs/path"},
                "status": {"const": "deferred"},
                "source": {"type": "object"},
                "recovery": {"type": "string", "minLength": 1}
              }
            }},
            "authority": {"type": "string", "pattern": "^none: "},
            "readiness": {"const": "unknown"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["schema", "base", "clock", "refusals", "authority", "readiness"],
          "properties": {
            "schema": {"const": "migrated-own-script-verification-record/1"},
            "base": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
            "clock": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
            "refusals": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1}}}},
            "authority": {"type": "string", "pattern": "^none: "},
            "readiness": {"const": "unknown"}
          }
        }
      ]
    }
  }
}
